{
  "name": "@ni2khanna/oas3-tools",
  "version": "3.1.0",
  "description": "Swagger-UI and API Rest Routing for Open API v3. Derived from oas3-tools (https://github.com/bug-hunters/oas3-tools).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist/ && tsc && cp -R src/middleware/swagger-ui dist/middleware/swagger-ui",
    "prepare": "yarn run build",
    "watch": "tsc --watch"
  },
  "author": "Nitin Khanna, <ni2.khanna@gmail.com> (https://github.com/papiguy)",
  "bugs": {
    "url": "https://github.com/papiguy/oas3-tools/issues"
  },
  "homepage": "https://github.com/papiguy/oas3-tools/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/papiguy/oas3-tools.git"
  },
  "keywords": [
    "api",
    "expressjs",
    "middleware",
    "swagger",
    "openapi 3"
  ],
  "files": [
    "bin",
    "index.js",
    "LICENSE",
    "lib",
    "src",
    "dist",
    "dist/middleware",
    "src/middleware",
    "schemas",
    "tsconfig.json"
  ],
  "dependencies": {
    "@types/multer": "1.4.7",
    "async": "3.2.3",
    "body-parser": "1.20.0",
    "cookie-parser": "1.4.6",
    "cors": "^2.8.5",
    "debug": "4.3.4",
    "eslint": "8.16.0",
    "eslint-plugin-react-hooks": "4.5.0",
    "express": "4.18.1",
    "express-openapi-validator": "4.13.9",
    "js-yaml": "4.1.0",
    "lodash": "4.17.21",
    "morgan": "^1.10.1",
    "ms": "2.1.3",
    "multer": "2.0.2",
    "parseurl": "^1.3.3",
    "path-to-regexp": "6.2.1",
    "qs": "6.10.3",
    "serve-static": "1.15.0"
  },
  "devDependencies": {
    "typescript": "4.7.2",
    "webpack": "5.72.1"
  },
  "directories": {
    "example": "examples"
  }
}
