    "debug": "^4.2.0",
    "eslint": "8.3.0",
    "eslint-plugin-react-hooks": "4.3.0",
    "express": "^4.17.1",
    "express-openapi-validator": "4.13.2",
    "js-yaml": "4.1.0",
    "lodash": "4.17.21",
    "morgan": "^1.10.0",
    "ms": "^2.1.2",
    "multer": "1.4.3",
    "parseurl": "^1.3.3",
