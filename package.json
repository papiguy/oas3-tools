  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/papiguy/oas3-tools.git"
  },
  "keywords": [
    "api",
    "expressjs",
    "middleware",
    "swagger",
    "openapi 3"
  ],
  "files": [
    "bin",
    "index.js",
    "LICENSE",
    "lib",
    "src",
    "dist",
    "dist/middleware",
    "src/middleware",
    "schemas",
    "tsconfig.json"
  ],
  "dependencies": {
