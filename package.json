{
  "name": "@ni2khanna/oas3-tools",
  "version": "3.0.2",
  "description": "Swagger-UI and API Rest Routing for Open API v3. Derived from oas3-tools (https://github.com/bug-hunters/oas3-tools).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist/ && tsc && cp -R src/middleware/swagger-ui dist/middleware/swagger-ui",
    "prepare": "yarn run build",
    "watch": "tsc --watch"
  },
  "author": "Nitin Khanna, <ni2.khanna@gmail.com> (https://github.com/papiguy)",
  "bugs": {
